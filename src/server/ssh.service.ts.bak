
import { Client } from "ssh2";
import { decryptSecret } from "./credentials.js";

type SSHConnectionOptions = {
  host: string;
  port: number;
  username: string;
  encryptedPrivateKey: string;
  encryptedPassphrase: string | null;
  hostKeyFingerprint: string;
};

function normalizeFingerprint(value: string): string {
  return value
    .trim()
    .replace(/^SHA256:/i, "")
    .replace(/=+$/, "");
}

export async function testSSHConnection(
  options: SSHConnectionOptions
): Promise<string> {
  const expectedFingerprint = normalizeFingerprint(
    options.hostKeyFingerprint
  );

  if (!expectedFingerprint) {
    throw new Error(
      "A trusted SHA-256 host fingerprint is required"
    );
  }

  const privateKey = decryptSecret(
    options.encryptedPrivateKey
  );

  const passphrase = options.encryptedPassphrase
    ? decryptSecret(options.encryptedPassphrase)
    : undefined;

  const client = new Client();

  return new Promise<string>((resolve, reject) => {
    let settled = false;

    const finish = (
      error?: Error,
      result?: string
    ): void => {
      if (settled) return;

      settled = true;
      client.end();

      if (error) {
        reject(error);
      } else {
        resolve(result ?? "");
      }
    };

    client.on("ready", () => {
      // Execute a fixed command; never interpolate user input.
      client.exec(
        "docker --version && docker info --format '{{.ServerVersion}}'",
        (error, stream) => {
          if (error) {
            finish(error);
            return;
          }

          let stdout = "";
          let stderr = "";

          const timeout = setTimeout(() => {
            stream.close();
            finish(
              new Error("Docker readiness check timed out")
            );
          }, 10000);

          stream.on(
            "data",
            (chunk: Buffer | string) => {
              stdout += chunk.toString();
            }
          );

          stream.stderr.on(
            "data",
            (chunk: Buffer | string) => {
              stderr += chunk.toString();
            }
          );

          stream.on(
            "close",
            (code: number | null) => {
              clearTimeout(timeout);

              if (code === 0) {
                finish(undefined, stdout.trim());
              } else {
                finish(
                  new Error(
                    stderr.trim() ||
                      `Docker readiness check failed (exit code ${code})`
                  )
                );
              }
            }
          );
        }
      );
    });

    client.on("error", (error: Error) => {
      finish(error);
    });

    client.on("close", () => {
      if (!settled) {
        finish(
          new Error(
            "SSH connection closed before the readiness check completed"
          )
        );
      }
    });

    client.connect({
      host: options.host,
      port: options.port,
      username: options.username,
      privateKey,
      ...(passphrase ? { passphrase } : {}),
      hostHash: "sha256",

      hostVerifier: (key: Buffer | string): boolean => {
        // ssh2 provides the hash when hostHash is configured.
        const actualHexHash = Buffer.isBuffer(key)
          ? key.toString("hex")
          : key;

        const actualFingerprint = Buffer.from(
          actualHexHash,
          "hex"
        )
          .toString("base64")
          .replace(/=+$/, "");

        return actualFingerprint === expectedFingerprint;
      },

      readyTimeout: 10000,
      keepaliveInterval: 5000,
      keepaliveCountMax: 2,
    });
  });
}


